# ── Mac / authorize: use PRODUCTION tab keys from developer.intuit.com ──
# Development and Production have DIFFERENT Client IDs — do not mix them.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://prime-qbo-webhook.netlify.app/oauth/callback
QBO_ENVIRONMENT=production
QBO_REALM_ID=

# ── Render only ──
# QBO_WEBHOOK_VERIFIER_TOKEN=   # Production webhooks tab (NOT Development)
# QBO_TOKENS_JSON=              # base64 from encode_tokens_for_render
# TAP_SECRET_KEY=
# TAP_REDIRECT_URL=https://prime-automation-hub.onrender.com/payment/success
# TAP_WEBHOOK_URL=https://prime-automation-hub.onrender.com/webhook/tap

# ── UPayments (sandbox first — not wired into live webhooks yet) ──
# UPAYMENTS_API_KEY=
# UPAYMENTS_MERCHANT_ID=78508
# UPAYMENTS_BASE_URL=https://sandboxapi.upayments.com/api/v1
# UPAYMENTS_RETURN_URL=https://prime-automation-hub.onrender.com/payment/success
# UPAYMENTS_CANCEL_URL=https://prime-automation-hub.onrender.com/payment/success
# UPAYMENTS_NOTIFICATION_URL=https://webhook.site/your-id
# UPAYMENTS_WEBHOOK_SECRET=   # optional; HMAC rollout in progress per UPayments FAQ

# Intuit Production webhook URL — either works:
#   https://prime-automation-hub.onrender.com/webhook
#   https://prime-qbo-webhook.netlify.app/quickbooks-webhook  (proxies to Render)

# ── Render persistent disk (recommended — survives redeploys) ──
# Mount disk at /data in Render dashboard, then:
# WEBHOOK_DB_PATH=/data/webhook_events.db
# DATABASE_PATH=/data/hub.db
# QBO_TOKEN_PATH=/data/tokens.json

# ── Netlify (optional — defaults to Render hub URL) ──
# RENDER_HUB_URL=https://prime-automation-hub.onrender.com
